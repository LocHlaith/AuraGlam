.recommend-page {
  padding-left: 0;
  padding-right: 0;
}

.page-head {
  padding: 0 32rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.eyebrow {
  display: block;
  color: #ff7aa2;
  font-size: 22rpx;
  font-weight: 900;
}

.page-title {
  display: block;
  margin-top: 8rpx;
  font-size: 48rpx;
  font-weight: 900;
}

.studio {
  margin: 30rpx 32rpx 0;
  display: grid;
  grid-template-columns: 272rpx 1fr;
  gap: 18rpx;
}

.portrait-wrap {
  position: relative;
  height: 444rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: #111316;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.portrait {
  width: 100%;
  height: 100%;
}

.face-grid {
  position: absolute;
  left: 38rpx;
  right: 38rpx;
  top: 66rpx;
  bottom: 76rpx;
  border: 2rpx solid rgba(255, 122, 162, 0.62);
  background:
    linear-gradient(90deg, rgba(255,255,255,0.1) 1rpx, transparent 1rpx) 0 0 / 48rpx 48rpx,
    linear-gradient(0deg, rgba(255,255,255,0.1) 1rpx, transparent 1rpx) 0 0 / 48rpx 48rpx;
}

.capture-button {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(5, 5, 6, 0.58);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
}

.voice-panel {
  min-height: 444rpx;
  border-radius: 32rpx;
  padding: 22rpx;
  background: rgba(255, 255, 255, 0.075);
  border: 1rpx solid rgba(255, 255, 255, 0.11);
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.voice-row {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.mic-button {
  width: 78rpx;
  height: 78rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff7aa2, #8fb5ff);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}

.mic-button.recording {
  box-shadow: 0 0 0 12rpx rgba(255, 122, 162, 0.18);
}

.mic-icon {
  width: 38rpx;
  height: 38rpx;
}

.prompt-input {
  width: 100%;
  min-height: 168rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(0, 0, 0, 0.22);
  color: #f7f4f2;
  font-size: 25rpx;
  line-height: 1.45;
}

.chip-row,
.scene-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip,
.scene-chip {
  height: 58rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  gap: 9rpx;
  color: rgba(247, 244, 242, 0.7);
  font-size: 22rpx;
  font-weight: 800;
}

.chip.selected,
.scene-chip.selected {
  color: #ffffff;
  background: rgba(143, 181, 255, 0.22);
  border-color: rgba(143, 181, 255, 0.42);
}

.chip-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.plan-list {
  border-radius: 28rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.11);
  background: rgba(255, 255, 255, 0.07);
}

.plan-row {
  min-height: 118rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.plan-row + .plan-row {
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.plan-index {
  width: 52rpx;
  color: #68d5c8;
  font-size: 24rpx;
  font-weight: 900;
}

.plan-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.plan-title {
  font-size: 27rpx;
  font-weight: 900;
}

.plan-desc {
  font-size: 22rpx;
  color: rgba(247, 244, 242, 0.62);
  line-height: 1.42;
}

.generate-button {
  width: 100%;
}

.generate-progress {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: 1fr 76rpx;
  align-items: center;
  gap: 16rpx;
  color: rgba(247, 244, 242, 0.62);
  font-size: 23rpx;
  text-align: right;
}

.result-section {
  margin-bottom: 24rpx;
}

.link-button {
  height: 54rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: #111316;
  font-size: 22rpx;
  font-weight: 900;
  background: #f7f4f2;
}

.result-view {
  position: relative;
  height: 720rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: #111316;
  border: 1rpx solid rgba(255, 255, 255, 0.11);
}

.result-video {
  width: 100%;
  height: 100%;
}

.result-badges {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.result-badges text {
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(5, 5, 6, 0.58);
  color: rgba(255, 255, 255, 0.82);
  font-size: 21rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
}
