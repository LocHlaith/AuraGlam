.scan-page {
  padding-left: 0;
  padding-right: 0;
}

.page-head {
  padding: 0 32rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.eyebrow {
  display: block;
  color: #68d5c8;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.page-title {
  display: block;
  margin-top: 8rpx;
  font-size: 48rpx;
  font-weight: 900;
}

.viewer {
  position: relative;
  height: 830rpx;
  margin-top: 30rpx;
  overflow: hidden;
  background: #111316;
}

.camera-feed {
  width: 100%;
  height: 100%;
}

.scan-shade {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(5, 5, 6, 0.12), rgba(5, 5, 6, 0.18)),
    radial-gradient(circle at center, rgba(255, 255, 255, 0) 0 42%, rgba(5, 5, 6, 0.45) 72%);
}

.scan-box {
  position: absolute;
  left: 14%;
  top: 13%;
  width: 72%;
  height: 64%;
  border: 2rpx solid rgba(255, 122, 162, 0.48);
}

.corner {
  position: absolute;
  width: 58rpx;
  height: 58rpx;
  border-color: #ff7aa2;
}

.lt {
  left: -4rpx;
  top: -4rpx;
  border-left: 8rpx solid;
  border-top: 8rpx solid;
}

.rt {
  right: -4rpx;
  top: -4rpx;
  border-right: 8rpx solid;
  border-top: 8rpx solid;
}

.lb {
  left: -4rpx;
  bottom: -4rpx;
  border-left: 8rpx solid;
  border-bottom: 8rpx solid;
}

.rb {
  right: -4rpx;
  bottom: -4rpx;
  border-right: 8rpx solid;
  border-bottom: 8rpx solid;
}

.scan-line {
  position: absolute;
  left: 0;
  right: 0;
  top: 42%;
  height: 4rpx;
  background: linear-gradient(90deg, rgba(255, 122, 162, 0), #ff7aa2, rgba(255, 122, 162, 0));
  animation: scanMove 1.3s linear infinite;
}

@keyframes scanMove {
  0% { transform: translateY(-220rpx); }
  100% { transform: translateY(220rpx); }
}

.landmark {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  margin-left: -5rpx;
  margin-top: -5rpx;
  border-radius: 50%;
  background: #68d5c8;
  box-shadow: 0 0 18rpx rgba(104, 213, 200, 0.8);
}

.viewer-caption {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 30rpx;
  min-height: 76rpx;
  border-radius: 24rpx;
  background: rgba(5, 5, 6, 0.52);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.82);
  font-size: 26rpx;
  font-weight: 800;
}

.control-row {
  margin: 26rpx 32rpx 0;
  display: grid;
  grid-template-columns: 1.4fr 1fr 0.74fr;
  gap: 16rpx;
}

.progress-section {
  margin-top: 42rpx;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.metric-card {
  height: 164rpx;
  border-radius: 28rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.075);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.metric-label {
  color: rgba(247, 244, 242, 0.62);
  font-size: 23rpx;
  font-weight: 700;
}

.metric-value {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  font-size: 44rpx;
  font-weight: 900;
}

.metric-unit {
  font-size: 22rpx;
  color: rgba(247, 244, 242, 0.58);
}

.suggestion-list {
  border-radius: 28rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.11);
  background: rgba(255, 255, 255, 0.07);
}

.suggestion-row {
  min-height: 88rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: rgba(247, 244, 242, 0.82);
  font-size: 25rpx;
  font-weight: 700;
}

.suggestion-row + .suggestion-row {
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ff7aa2;
}
