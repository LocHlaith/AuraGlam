.routine-page {
  padding-left: 0;
  padding-right: 0;
}

.page-head {
  padding: 0 32rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.eyebrow {
  display: block;
  color: #8fb5ff;
  font-size: 22rpx;
  font-weight: 900;
}

.page-title {
  display: block;
  margin-top: 8rpx;
  font-size: 48rpx;
  font-weight: 900;
}

.arm-stage {
  position: relative;
  height: 560rpx;
  margin-top: 30rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 73% 35%, rgba(255, 122, 162, 0.2), rgba(255, 122, 162, 0) 31%),
    linear-gradient(155deg, #14171f, #07080b);
}

.face-target {
  position: absolute;
  right: 84rpx;
  top: 80rpx;
  width: 206rpx;
  height: 274rpx;
  border-radius: 48% 48% 46% 46%;
  background: linear-gradient(180deg, #ffe3d8, #e8adc0);
  box-shadow: inset 0 -24rpx 36rpx rgba(174, 84, 111, 0.24);
}

.face-target::before,
.face-target::after {
  content: "";
  position: absolute;
  top: 118rpx;
  width: 34rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #4c3039;
}

.face-target::before {
  left: 48rpx;
}

.face-target::after {
  right: 48rpx;
}

.arm-base {
  position: absolute;
  left: 70rpx;
  bottom: 86rpx;
  width: 128rpx;
  height: 92rpx;
  border-radius: 36rpx 36rpx 18rpx 18rpx;
  background: #8fb5ff;
}

.arm-link {
  position: absolute;
  height: 42rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #e9edf8, #8fb5ff);
  transform-origin: left center;
}

.arm-link.one {
  left: 154rpx;
  bottom: 175rpx;
  width: 236rpx;
  transform: rotate(-34deg);
}

.arm-link.two {
  left: 354rpx;
  bottom: 304rpx;
  width: 214rpx;
  transform: rotate(22deg);
}

.joint {
  position: absolute;
  width: 78rpx;
  height: 78rpx;
  border-radius: 50%;
  background: #f7f4f2;
  border: 14rpx solid #416fd4;
}

.j1 {
  left: 128rpx;
  bottom: 148rpx;
}

.j2 {
  left: 337rpx;
  bottom: 284rpx;
}

.tool-head {
  position: absolute;
  right: 268rpx;
  top: 198rpx;
  width: 96rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #ff7aa2, #68d5c8);
}

.mist {
  position: absolute;
  right: 248rpx;
  top: 212rpx;
  width: 122rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  filter: blur(6rpx);
  animation: pulse 1.6s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(0.82); opacity: 0.36; }
  50% { transform: scale(1.14); opacity: 0.8; }
}

.stage-caption {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 30rpx;
  min-height: 86rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.routine-actions {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: 1.35fr 1fr 1fr;
  gap: 16rpx;
}

.step-list,
.log-list {
  border-radius: 28rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.11);
  background: rgba(255, 255, 255, 0.07);
}

.step-row {
  min-height: 106rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  color: rgba(247, 244, 242, 0.58);
}

.step-row + .step-row,
.log-row + .log-row {
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.step-row.active {
  color: #ffffff;
  background: rgba(143, 181, 255, 0.16);
}

.step-row.done {
  color: rgba(104, 213, 200, 0.92);
}

.step-mark {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  font-size: 22rpx;
  font-weight: 900;
}

.step-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.step-name {
  font-size: 26rpx;
  font-weight: 900;
}

.step-tool,
.step-duration {
  font-size: 21rpx;
}

.telemetry-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.telemetry-card {
  height: 120rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.075);
  border: 1rpx solid rgba(255, 255, 255, 0.11);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 20rpx;
  color: rgba(247, 244, 242, 0.58);
}

.telemetry-card text + text {
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
}

.log-row {
  min-height: 84rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
  font-weight: 750;
  color: rgba(247, 244, 242, 0.76);
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #68d5c8;
}
