.tabbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(env(safe-area-inset-bottom) + 18rpx);
  z-index: 50;
  height: 116rpx;
  padding: 12rpx;
  border-radius: 34rpx;
  background: rgba(26, 26, 29, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 8rpx;
  box-shadow: 0 -14rpx 46rpx rgba(0, 0, 0, 0.42);
}

.tab {
  height: 92rpx;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: rgba(247, 244, 242, 0.52);
  font-size: 22rpx;
  font-weight: 700;
}

.tab.active {
  color: #ffffff;
  background: linear-gradient(180deg, rgba(255, 122, 162, 0.2), rgba(143, 181, 255, 0.14));
}

.tab-icon {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.74;
}

.tab.active .tab-icon {
  opacity: 1;
}
