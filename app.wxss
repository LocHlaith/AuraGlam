page {
  min-height: 100%;
  background: #050506;
  color: #f7f4f2;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

view,
text,
button,
input,
textarea,
scroll-view {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  border: 0;
  background: transparent;
  color: inherit;
  line-height: 1.2;
  font: inherit;
}

button::after {
  border: 0;
}

.page-shell {
  min-height: 100vh;
  padding-bottom: 156rpx;
  background:
    linear-gradient(180deg, rgba(5, 5, 6, 0) 0%, #050506 44%),
    #050506;
}

.safe-top {
  padding-top: calc(env(safe-area-inset-top) + 26rpx);
}

.section {
  padding: 0 32rpx;
  margin-top: 34rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 22rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.section-note {
  font-size: 23rpx;
  color: rgba(247, 244, 242, 0.62);
}

.glass-panel {
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.075);
  backdrop-filter: blur(18rpx);
}

.primary-button {
  min-height: 96rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #8fb5ff 0%, #416fd4 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  box-shadow: 0 18rpx 42rpx rgba(70, 111, 212, 0.25);
}

.soft-button {
  min-height: 78rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.1);
  color: #f7f4f2;
  font-size: 27rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.tiny-icon {
  width: 34rpx;
  height: 34rpx;
  display: block;
}

.status-pill {
  min-height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
  background: rgba(255, 255, 255, 0.11);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.progress-track {
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ff7aa2, #8fb5ff, #68d5c8);
}

.muted {
  color: rgba(247, 244, 242, 0.62);
}
